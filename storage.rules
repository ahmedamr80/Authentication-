rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'admin') ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isSmallEnough() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Default: authenticated users can read, only admins can write
    match /{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Public assets that should remain accessible without auth
    match /public/{allPaths=**} {
      allow read: if true;
    }

    // Event and club images are shown on public-facing pages
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && isSmallEnough();
    }

    match /club-pictures/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && isSmallEnough();
    }

    match /profile-pictures/{userId} {
      allow read: if true;
      allow write: if (isAdmin() || isOwner(userId)) && isImage() && isSmallEnough();
    }

    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAdmin() || isOwner(userId)) && isImage() && isSmallEnough();
    }

    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow write: if (isAdmin() || isOwner(userId)) && isImage() && isSmallEnough();
    }

    match /user-uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAdmin() || isOwner(userId)) && isImage() && isSmallEnough();
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && isSmallEnough();
    }
  }
}